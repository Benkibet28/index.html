  <title>BENTECH | Fiber & Wi-Fi Solutions</title>
  <meta name="description" content="BENTECH provides fiber installation, Wi-Fi setup, router configuration and networking services in Kenya.">

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
      line-height: 1.6;
    }

    header {
      background: #071b35;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 { color: #36c5f0; }

    nav {
      background: #102b4e;
      padding: 12px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
    }

    .hero {
      padding: 75px 20px;
      text-align: center;
      background: linear-gradient(135deg, #071b35, #1266a8);
      color: white;
    }

    .hero h2 { font-size: 34px; margin-bottom: 15px; }
    .hero p { max-width: 600px; margin: auto auto 25px; }

    .btn {
      display: inline-block;
      background: #20c997;
      color: #06251e;
      padding: 12px 22px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    section { padding: 45px 20px; }

    section h2 {
      text-align: center;
      margin-bottom: 25px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      max-width: 1000px;
      margin: auto;
    }

    .service {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px #0000000d;
    }

    .service h3 { color: #1266a8; margin-bottom: 10px; }

    .about {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .contact {
      text-align: center;
      background: #e6eef8;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: #071b35;
      color: white;
    }

    @media (max-width: 480px) {
      .hero h2 { font-size: 27px; }
      nav a { display: inline-block; margin: 5px; }
    }
